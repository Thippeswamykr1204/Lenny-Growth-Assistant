# Copy this file to .env and fill in values. Never commit .env.
# Every variable below is annotated REQUIRED or OPTIONAL.

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development                # OPTIONAL. development | production. Default shown is safe.
LOG_LEVEL=INFO                     # OPTIONAL. DEBUG | INFO | WARNING | ERROR.

# ── Database (REQUIRED) ─────────────────────────────────────────────
# These three build DATABASE_URL below — keep them consistent with it.
POSTGRES_USER=lenny                # REQUIRED. Any non-empty value for local dev.
POSTGRES_PASSWORD=changeme_local_only   # REQUIRED. Local-only value; never reuse in a real deployment.
POSTGRES_DB=lenny_assistant        # REQUIRED.
DATABASE_URL=postgresql+asyncpg://lenny:changeme_local_only@db:5432/lenny_assistant
                                    # REQUIRED. Must point at the `db` service (Docker network hostname),
                                    # not localhost, when running via docker compose.
DB_HOST_PORT=5433                  # OPTIONAL. Host-side port for the db container. Defaults to 5433
                                    # (not 5432) to avoid colliding with a local Postgres install on
                                    # your machine. Only matters if you connect to the DB from a tool
                                    # on your host (psql, a GUI client) — DATABASE_URL above is
                                    # unaffected since it uses the Docker network hostname.

# ── Provider routing (REQUIRED default, locked Tier 0 decision) ────
DEFAULT_LLM_PROVIDER=ollama        # REQUIRED. ollama | anthropic. Env-var default; overridable per-request
                                    # via `"provider"` in the /api/chat/stream body — never model-decided,
                                    # never a silent fallback to the other provider on failure.

# ── Ollama (local inference) ────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434  # REQUIRED if DEFAULT_LLM_PROVIDER=ollama or --profile local-ai is used.
                                      # Docker network hostname, not localhost, inside Compose.
OLLAMA_MODEL=llama3.2:3b             # REQUIRED if using Ollama. Pending final hardware confirmation
                                      # per PRD.md assumption #4 — change this one line if a larger
                                      # model is confirmed safe on your machine.
LOCAL_AI_ENABLED=true                # OPTIONAL. Set to true only when running with `--profile local-ai`,
                                      # so the health endpoint knows to probe Ollama. Not a secret.

# ── Cloud provider ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...       # REQUIRED only if DEFAULT_LLM_PROVIDER=anthropic (the backend fails
                                    # fast at startup with a CRITICAL log if it's blank in that case — see
                                    # "Resilience & troubleshooting" in README.md). Leave blank to run
                                    # local-only with ollama.

# ── Ingestion / embeddings (Tier 2) ─────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
                                    # OPTIONAL. Local sentence-transformers model used to embed both
                                    # transcript chunks at ingest time and queries at retrieval time.
                                    # Must match the 384-dim vector column in migrations/001_init.sql
                                    # if changed.
EMBEDDING_DIM=384                  # OPTIONAL. Must match the embedding model's output dimension and
                                    # the `vector(384)` column in the DB migration.
CHUNK_TARGET_TOKENS=650            # OPTIONAL. Target chunk size when splitting transcripts.
CHUNK_OVERLAP_TOKENS=100           # OPTIONAL. Overlap between consecutive chunks.
TRANSCRIPTS_SOURCE_REPO=https://github.com/ChatPRD/lennys-podcast-transcripts
                                    # OPTIONAL. Source repo the ingestion script pulls transcripts from.
TRANSCRIPTS_DIR=data/transcripts   # OPTIONAL. Local directory the ingestion script reads transcript
                                    # files from (and download_transcripts.py writes to).

# ── Retrieval / confidence gating (Tier 3) ──────────────────────────
RETRIEVAL_TOP_K=5                  # OPTIONAL. Number of chunks retrieved per query.
SIMILARITY_THRESHOLD_HIGH=0.75     # OPTIONAL. Cosine-similarity threshold for a "high confidence" answer.
SIMILARITY_THRESHOLD_MODERATE=0.65 # OPTIONAL. Below this, the assistant abstains ("not in the archive").
                                    # See docs/architecture.md for current tuning status against real
                                    # eval numbers — these remain the original best-guess defaults.

# ── Anthropic model (Tier 3) ────────────────────────────────────────
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
                                    # OPTIONAL. Only read when DEFAULT_LLM_PROVIDER=anthropic.

# ── Ship 30 for 30 skill (Tier 4) ───────────────────────────────────
SHIP30_MIN_WORDS=1100               # OPTIONAL. Lower bound of the deterministic word-count validator.
SHIP30_MAX_WORDS=1400               # OPTIONAL. Upper bound of the deterministic word-count validator.

# ── Resilience / timeouts (Tier 5) ──────────────────────────────────
PROVIDER_TIMEOUT_SECONDS=240          # OPTIONAL. Fallback default both timeouts below inherit
                                      # from when not set individually.
# OPTIONAL. Overrides PROVIDER_TIMEOUT_SECONDS for Ollama calls only.
OLLAMA_TIMEOUT_SECONDS=
                                      # Leave blank to inherit the fallback above.
# OPTIONAL. Overrides PROVIDER_TIMEOUT_SECONDS for Anthropic calls only.
ANTHROPIC_TIMEOUT_SECONDS=
                                      # Leave blank to inherit the fallback above.
DB_POOL_TIMEOUT_SECONDS=5            # OPTIONAL. Seconds a request waits for a free DB connection
                                      # before failing fast with a typed "database unavailable" error.
MAX_PROMPT_CHARS=8000                # OPTIONAL. Upper bound on a single chat message's length,
                                      # validated before retrieval or any provider call is made.

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
                                    # REQUIRED. Browser-facing URL of the backend (host machine's
                                    # localhost, NOT the Docker network hostname — this is read by
                                    # client-side JS in the browser, outside the Compose network).